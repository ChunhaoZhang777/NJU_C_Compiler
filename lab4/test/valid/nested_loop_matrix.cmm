int main()
{
    int grid[2][3], row = 0, column;
    while (row < 2)
    {
        column = 0;
        while (column < 3)
        {
            grid[row][column] = (row + 1) * 10 + column;
            write(grid[row][column]);
            column = column + 1;
        }
        row = row + 1;
    }
    return 0;
}
